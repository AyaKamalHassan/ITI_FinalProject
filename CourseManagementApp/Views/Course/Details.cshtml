@model CourseManagementApp.Models.Course

@{
    ViewData["Title"] = "Course Details";
}

<div class="container mt-5">
    <div class="col-lg-7 col-md-9 mx-auto">
        <div class="cyber-card p-4 p-md-5">
            <div class="d-flex justify-content-between align-items-start mb-4">
                <div>
                    <span class="badge badge-pink mb-2">Track ID #@Model.Id</span>
                    <h2 class="fw-bold text-white mb-0">@Model.Title</h2>
                </div>
                <h3 class="fw-bold" style="color: var(--primary-pink);">@Model.Price.ToString("N2") <small class="fs-6 text-muted">EGP</small></h3>
            </div>

            <div class="p-3 rounded-3 mb-4" style="background: rgba(255,255,255,0.02); border: 1px solid var(--border-color);">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <small class="text-secondary d-block">Lead Instructor</small>
                        <span class="fw-semibold text-white">
                            <i class="bi bi-person-fill text-danger me-1" style="color: var(--primary-pink) !important;"></i>
                            @(Model.Instructor?.Name ?? "N/A")
                        </span>
                        <div class="small text-muted">@(Model.Instructor?.Email ?? "")</div>
                    </div>
                    <div class="col-sm-6">
                        <small class="text-secondary d-block">Training Duration</small>
                        <span class="fw-semibold text-white">
                            <i class="bi bi-clock-fill text-danger me-1" style="color: var(--primary-pink) !important;"></i>
                            @Model.DurationInHours Total Hours
                        </span>
                    </div>
                </div>
            </div>

            <div class="mb-4">
                <h6 class="text-secondary text-uppercase fw-bold small">Course Overview</h6>
                <p class="text-light leading-relaxed">@Model.Description</p>
            </div>

            <div class="d-flex justify-content-between pt-3 border-top" style="border-color: var(--border-color) !important;">
                <a asp-action="Index" class="btn btn-dark-subtle px-4">
                    <i class="bi bi-arrow-left me-1"></i> Back to Catalog
                </a>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-pink px-4">
                    <i class="bi bi-pencil me-1"></i> Edit Course
                </a>
            </div>
        </div>
    </div>
</div>