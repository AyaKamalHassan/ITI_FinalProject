@model CourseManagementApp.Models.Course

@{
    ViewData["Title"] = "Delete Course";
}

<div class="container mt-5">
    <div class="col-lg-6 col-md-8 mx-auto">
        <div class="cyber-card p-4 p-md-5" style="border-color: rgba(255, 45, 117, 0.4);">
            <div class="d-flex align-items-center gap-3 mb-3">
                <i class="bi bi-exclamation-octagon fs-1 text-danger" style="color: var(--primary-pink) !important;"></i>
                <div>
                    <h3 class="fw-bold text-white mb-0">Confirm Deletion</h3>
                    <p class="text-secondary small mb-0">Action cannot be reversed.</p>
                </div>
            </div>

            <div class="alert alert-pink mb-4">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.Warning
            </div>

            <div class="p-3 rounded-3 mb-4" style="background: rgba(255,255,255,0.02); border: 1px solid var(--border-color);">
                <div class="mb-2">
                    <small class="text-secondary">Course Title:</small>
                    <div class="fw-bold text-white">@Model.Title</div>
                </div>
                <div class="mb-2">
                    <small class="text-secondary">Instructor:</small>
                    <div class="text-white">@(Model.Instructor?.Name ?? "None")</div>
                </div>
                <div>
                    <small class="text-secondary">Duration:</small>
                    <div class="text-white">@Model.DurationInHours Hours</div>
                </div>
            </div>

            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div class="d-flex justify-content-between align-items-center">
                    <a asp-action="Index" class="btn btn-dark-subtle px-4">Cancel</a>
                    <button type="submit" class="btn btn-pink px-4">Confirm Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>