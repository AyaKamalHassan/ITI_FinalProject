@model CourseManagementApp.ViewModels.CourseViewModel

@{
    ViewData["Title"] = "Edit Course";
}

<div class="container mt-5">
    <div class="col-lg-6 col-md-8 mx-auto">
        <div class="cyber-card p-4 p-md-5">
            <h3 class="fw-bold text-white mb-1">Edit Course</h3>
            <p class="text-secondary small mb-4">Modify program specifications and instructor assignment.</p>

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="alert alert-pink mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="InstructorId" class="form-label"></label>
                    <select asp-for="InstructorId" asp-items="@ViewBag.Instructors" class="form-select"></select>
                    <span asp-validation-for="InstructorId" class="text-danger small"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="DurationInHours" class="form-label"></label>
                        <input asp-for="DurationInHours" type="number" class="form-control" />
                        <span asp-validation-for="DurationInHours" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Price" class="form-label"></label>
                        <input asp-for="Price" type="number" step="50" class="form-control" />
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-2">
                    <a asp-action="Index" class="btn btn-dark-subtle px-4">Cancel</a>
                    <button type="submit" class="btn btn-pink px-4">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}